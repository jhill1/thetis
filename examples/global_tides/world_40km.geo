Physical Line(223) = {71, 84, 83, 82, 81, 80, 79, 78, 77, 76, 75, 74, 73, 72, 85, 70, 69, 68, 67, 66, 65, 64, 63, 62, 61, 60, 59, 58, 99, 111, 110, 109, 108, 107, 106, 105, 104, 103, 102, 101, 100, 57, 98, 97, 96, 95, 94, 93, 92, 91, 90, 89, 88, 87, 86, 15, 28, 27, 26, 25, 24, 23, 22, 21, 20, 19, 18, 17, 16, 29, 14, 13, 12, 11, 10, 9, 8, 7, 6, 5, 4, 3, 2, 43, 56, 55, 54, 53, 52, 51, 50, 49, 48, 47, 46, 45, 44, 1, 42, 41, 40, 39, 38, 37, 36, 35, 34, 33, 32, 31, 30};

// input bathymetry
Field[1] = Structured;
Field[1].FileName = "bathymetry.fld";
Field[1].TextFormat = 1;
// constant edge length to use as initial mesh in testing - switch background below
Field[2] = MathEval;
Field[2].F = "2.0E5";
// convert bathymetry to cartesian space (default field to use is 1)
Field[3] = LonLat;
Field[4] = MathEval;
Field[4].F = "Abs(F3)";
// Set a minimum bathymetry
Field[5] = MathEval;
Field[5].F = "10";
Field[6] = Max;
Field[6].FieldsList = {5, 4};
Field[7] = MathEval;
Field[7].F = "F6/10";
// So F4 is the unaltered bathymetry, F6 has a minimum depth applied, and F7 is the edited bathymetry divided by a minimum depth scaling factor
// Set up the Max eigenvalue of the hessian of bathymetry field
Field[8] = MaxEigenHessian;
Field[8].Delta = 800000;
Field[8].IField = 7;
Field[9] = MathEval;
Field[8].IField = 6;
// we need to limit the hessian field to be positive or we get errors
Field[14] = Max;
Field[15] = MathEval;
Field[15].F = "0";
Field[14].FieldsList = {8, 15};
Field[15].F = "1e-9";
Field[9].F = "1/Sqrt(F14)";
// Now alter edge length based on bathymetry values
Field[10] = MathEval;
Field[10].F = "100000.0/3.0*Sqrt(F7)";
// Now alter based on distance from coastline - copy the line IDs fro the Physical Line above
Field[11] = Attractor;
Field[11].EdgesList = { 999999, 71, 84, 83, 82, 81, 80, 79, 78, 77, 76, 75, 74, 73, 72, 85, 70, 69, 68, 67, 66, 65, 64, 63, 62, 61, 60, 59, 58, 99, 111, 110, 109, 108, 107, 106, 105, 104, 103, 102, 101, 100, 57, 98, 97, 96, 95, 94, 93, 92, 91, 90, 89, 88, 87, 86, 15, 28, 27, 26, 25, 24, 23, 22, 21, 20, 19, 18, 17, 16, 29, 14, 13, 12, 11, 10, 9, 8, 7, 6, 5, 4, 3, 2, 43, 56, 55, 54, 53, 52, 51, 50, 49, 48, 47, 46, 45, 44, 1, 42, 41, 40, 39, 38, 37, 36, 35, 34, 33, 32, 31, 30};
Field [11].NNodesByEdge = 5e3;
Field[12] = Threshold;
Field[12].DistMax = 400e3;
Field[12].DistMin = 80e3;
Field[12].IField = 11;
Field[12].LcMin = 40e3;
Field[12].LcMax = 200e3;
// Now take the minimum of the three sizing fields, F12, F10 and F9
Field[13] = Min;
Field[13].FieldsList = {9, 10, 12};
//Don't extent the elements sizes from the boundary inside the domain
Mesh.CharacteristicLengthExtendFromBoundary = 0;
// Set background field. 13 is the full metric. 12 is the threshold to shoreline and 2 is a constant edge length
Background Field = 12;
Field[9].F = "1/Sqrt(F14)";
Field[9].F = "10/Sqrt(F14)";
Field[9].F = "5/Sqrt(F14)";
